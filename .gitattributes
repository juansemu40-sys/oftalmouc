# Finales de línea correctos en cualquier sistema operativo.
* text=auto
# Los scripts de shell y Dockerfile deben conservar LF aunque se clonen en Windows.
*.sh text eol=lf
Dockerfile text eol=lf
# Los scripts de Windows necesitan CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
# Binarios
*.png binary
*.jpg binary
*.ico binary
*.onnx binary
