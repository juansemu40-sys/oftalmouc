# =====================================================================================
#  Oftalmología + IA — variables de entorno
#  1) Copie este archivo:  cp .env.example .env   (./run.sh lo hace solo si no existe)
#  2) Pegue SU llave en la variable del proveedor elegido. NUNCA suba .env al repositorio.
#  Los comentarios van siempre en su propia línea (no al final de un valor).
# =====================================================================================

# ---------- 1. Proveedor LLM (extracción + explicación) ----------
# Valores posibles: groq | gemini | openai | mock
#   groq   -> modelo por defecto openai/gpt-oss-120b  (recomendado: más rápido y barato)
#   gemini -> modelo por defecto gemini-2.5-flash
#   openai -> modelo por defecto gpt-4o-mini
#   mock   -> IA simulada por reglas: sin red ni llaves (solo pruebas o plan B de la demo)
LLM_PROVIDER=groq

# Llave del proveedor elegido (solo se usa la que corresponde a LLM_PROVIDER).
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vacío = modelo por defecto del proveedor. Ejemplo para cambiarlo: LLM_MODEL=openai/gpt-oss-20b
LLM_MODEL=

# ---------- 2. Transcripción (Whisper) ----------
# Para la mejor precisión: TRANSCRIPCION_PROVIDER=groq y WHISPER_GROQ_MODEL=whisper-large-v3 (usa la misma GROQ_API_KEY).
# local -> faster-whisper dentro del contenedor (el audio no sale del equipo)
# groq  -> whisper-large-v3-turbo en Groq (más rápido; requiere GROQ_API_KEY)
TRANSCRIPCION_PROVIDER=local
# Modelo local: tiny | base | small | medium. "small" = buen balance en español con CPU.
WHISPER_MODEL=small
# true = el modelo se descarga al construir la imagen (la demo no espera descargas).
PRECARGAR_WHISPER=true

# ---------- 2b. Voz: la explicación aprobada, leída en voz alta ----------
# Para pacientes con baja visión, adultos mayores o personas que no leen.
#   piper      -> voz neuronal que corre en este equipo (el texto no sale a internet)
#   elevenlabs -> voz en la nube muy humana (https://elevenlabs.io). El texto aprobado sale a ElevenLabs.
#                 Plan gratis: unos 10.000 caracteres al mes (unas 5 explicaciones).
#   ninguno    -> sin voz en el servidor; el navegador la lee con su propia voz
VOZ_PROVIDER=piper
# Voz de Piper que se descarga al construir la imagen (español de México, calidad alta).
VOZ_PIPER=es_MX-claude-high
PRECARGAR_VOZ=true
# Ritmo de lectura: 1.0 normal; más alto = más pausado. (La app tiene además el botón "Más despacio".)
VOZ_RITMO=1.05
# Variación de entonación y de ritmo: más bajo = voz más pareja y estable; más alto = más expresiva.
VOZ_VARIACION=0.5
VOZ_VARIACION_RITMO=0.6

# --- Solo si VOZ_PROVIDER=elevenlabs ---
# Llave: https://elevenlabs.io -> Developers -> API Keys (con permiso de Text to Speech).
ELEVENLABS_API_KEY=
# Voice ID de la voz elegida (elevenlabs.io -> Voices -> la voz -> "Copy voice ID"). Busque voces en español latino.
ELEVENLABS_VOZ_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_multilingual_v2 = mejor calidad; eleven_flash_v2_5 = gasta la mitad de créditos y es más rápido.
ELEVENLABS_MODELO=eleven_multilingual_v2

# ---------- 3. Base de datos (PostgreSQL en Docker) ----------
POSTGRES_DB=oftalmologia
POSTGRES_USER=oftalmologia
POSTGRES_PASSWORD=oftalmologia_local
# Informativo: docker-compose.yml construye esta URL automáticamente para el contenedor backend.
DATABASE_URL=postgresql+psycopg://oftalmologia:oftalmologia_local@db:5432/oftalmologia

# ---------- 4. Límites del agente (los 4 límites activos) ----------
AGENTE_MAX_ITERACIONES=5
AGENTE_TIMEOUT_S=60
AGENTE_MAX_TOKENS_TOTALES=20000
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS_RESPUESTA=4096
LLM_TEMPERATURE=0

# ---------- 5. Colombia ----------
# TRM: pesos colombianos por dólar, para mostrar el costo de la IA en COP.
# Referencia: ~3.160 a finales de octubre de 2026. Actualícela con la TRM del día (Banco de la República).
TRM_COP=3160

# ---------- 5b. Código QR para el paciente ----------
# Dirección a la que apunta el QR. Déjela vacía: iniciar.bat / run.ps1 usa, en este orden,
#   1) Tailscale Funnel si está activo (https://<pc>.<red>.ts.net: abre desde CUALQUIER red), o
#   2) la IP del PC en el Wi-Fi (ej.: http://192.168.1.20:8080: solo abre en la misma red).
# Fíjela solo si la detección falla o si publica la app en un servidor (ej.: https://oftalmo.mi-clinica.co).
URL_PUBLICA=
# Puerto local de la "puerta" (solo deja pasar la página del paciente). Tailscale Funnel apunta aquí.
PUERTO_PUERTA=8090
# Días que el enlace del QR sigue abierto; después se cierra solo (el médico también puede anularlo).
ENLACE_PACIENTE_DIAS=30

# ---------- 5c. Acceso del médico ----------
# Sin contraseña nadie puede entrar a la app. Escríbala usted (mínimo 10 caracteres); no la comparta.
# Tras 5 intentos fallidos desde un mismo equipo, el ingreso se bloquea 15 minutos.
MEDICO_USUARIO=medico
MEDICO_CLAVE=
# Minutos sin usar la app tras los que la sesión se cierra sola (siempre se cierra a las 12 horas).
SESION_INACTIVIDAD_MIN=120
# Duración máxima de un dictado subido (minutos).
MAX_AUDIO_MINUTOS=20

# ---------- 6. Demo y puertos ----------
# Permite simular fallos de la IA con POST /api/demo/falla (timeout, caída, 429, JSON roto).
PERMITIR_SIMULAR_FALLAS=true
PUERTO_WEB=8080
PUERTO_API=8000
